# CoBuild Monorepo Environment Variables
# COPY THIS TO .env IN ROOT OR AS NEEDED

# Environment
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev

# Application Ports
API_PORT=8080
WEB_PORT=3000

# Database (MongoDB with single-node replica set rs0 for transactions)
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/cobuild?replicaSet=rs0

# JWT & Security (Secret must be at least 256 bits = 32+ characters)
JWT_SECRET=cobuild_jwt_super_secure_secret_key_minimum_256_bits_length_123456
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Mail Server (MailHog for local dev)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth2 (Optional for local dev)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
